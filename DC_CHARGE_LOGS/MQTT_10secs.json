everest/manifests/DummyTokenProvider {"description":"Dummy token provider that listens to AuthRequired event from evse_manager and then publishes one token","enable_external_mqtt":false,"enable_global_errors":false,"enable_telemetry":false,"metadata":{"authors":["Thilo Molitor","Cornelius Claussen"],"license":"https://opensource.org/licenses/Apache-2.0"},"provides":{"main":{"config":{"connector_id":{"default":0,"description":"If >0, the generated token is only valid for this connector_id","minimum":0,"mutability":"ReadOnly","type":"integer"},"timeout":{"default":10,"description":"Time our dummy token is valid (in s)","maximum":120,"minimum":0,"mutability":"ReadOnly","type":"number"},"token":{"default":"DEADBEEF","description":"Dummy token string to return","maxLength":20,"minLength":1,"mutability":"ReadOnly","type":"string"},"type":{"default":"RFID","description":"Type to report for our dummy token","maxLength":32,"minLength":2,"mutability":"ReadOnly","type":"string"}},"description":"Main implementation of dummy token provider always returning one configured token","interface":"auth_token_provider"}},"requires":{"evse":{"interface":"evse_manager","max_connections":1,"min_connections":1}}}
everest/manifests/DummyTokenValidator {"description":"Dummy token validator always returning the same configured token validation result for every token","enable_external_mqtt":false,"enable_global_errors":false,"enable_telemetry":false,"metadata":{"authors":["Thilo Molitor","Cornelius Claussen"],"license":"https://opensource.org/licenses/Apache-2.0"},"provides":{"main":{"config":{"sleep":{"default":0.5,"description":"Time to wait before returning the dummy validation result (in s)","maximum":120,"minimum":0,"mutability":"ReadOnly","type":"number"},"validation_reason":{"default":"Token valid","description":"Dummy validation reason to return","minLength":5,"mutability":"ReadOnly","type":"string"},"validation_result":{"default":"Accepted","description":"Dummy validation result to return","enum":["Accepted","Blocked","Expired","Invalid"],"mutability":"ReadOnly","type":"string"}},"description":"Main implementation of dummy token validator always returning the same configured token validation result for every token","interface":"auth_token_validator"}},"requires":{}}
