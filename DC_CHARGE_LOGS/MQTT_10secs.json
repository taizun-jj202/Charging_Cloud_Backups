everest/manifests/EvseSlac {"description":"Implementation of SLAC data link negotiation according to ISO15118-3.","enable_external_mqtt":false,"enable_global_errors":false,"enable_telemetry":false,"metadata":{"authors":["aw@pionix.de","Cornelius Claussen (Pionix GmbH)"],"base_license":"https://directory.fsf.org/wiki/License:BSD-3-Clause-Clear","license":"https://opensource.org/licenses/Apache-2.0"},"provides":{"main":{"config":{"ac_mode_five_percent":{"default":true,"description":"Use AC 5% mode according to ISO15118-3. This restarts SLAC sessions if they fail according to the standard. The standard only allows the retries for AC, not for DC. However, it is strongly recommended to always set this option to true, also for DC, otherwise some EVs in the field will fail to do SLAC frequently.","mutability":"ReadOnly","type":"boolean"},"chip_reset_delay_ms":{"default":100,"description":"Delay between SET_KEY.CNF and RS_DEV.REQ","mutability":"ReadOnly","type":"integer"},"chip_reset_timeout_ms":{"default":500,"description":"Timeout for RS_DEV.REQ (waiting for RS_DEV.CNF)","mutability":"ReadOnly","type":"integer"},"debug_simulate_failed_matching":{"default":false,"description":"Only for debugging. Simulate failed matching by sending a wrong NMK to the EV.","mutability":"ReadOnly","type":"boolean"},"device":{"default":"eth1","description":"Ethernet device used for PLC.","mutability":"ReadOnly","type":"string"},"do_chip_reset":{"default":false,"description":"Perform a chip reset after setting NMK using the RS_DEV.REQ Vendor MME Extension (Only works on Qualcomm chips)","mutability":"ReadOnly","type":"boolean"},"link_status_detection":{"default":false,"description":"After matching.cnf, wait for link to come up before sending out d_link_ready=connected using LINK_STATUS Vendor MME Extension (Works on Qualcomm and Lumissil chips)","mutability":"ReadOnly","type":"boolean"},"link_status_retry_ms":{"default":100,"description":"Delay between retries of LINK_STATUS requests after matching request","mutability":"ReadOnly","type":"integer"},"link_status_timeout_ms":{"default":10000,"description":"Timeout for Link to come up after matching request","mutability":"ReadOnly","type":"integer"},"number_of_sounds":{"default":10,"description":"SLAC number of sounds.","mutability":"ReadOnly","type":"integer"},"publish_mac_on_first_parm_req":{"default":false,"description":"Publish the EV MAC address when the first CM_SLAC_PARM.REQ. This should not be used as it is quite error prone: The MAC address might be from another car via cross talk. It is better to wait for the matching to be done.","mutability":"ReadOnly","type":"boolean"},"publish_mac_on_match_cnf":{"default":true,"description":"Publish the EV MAC address on the token_provider interface when matching is confirmed (CM_SLAC_MATCH.CNF). This can be used for autocharge as an alternative to the EVCCID derived from HLC and published by EvseManager.  This can be used for AC autocharge on cars that do not support actual HLC on AC.","mutability":"ReadOnly","type":"boolean"},"reset_instead_of_fail":{"default":true,"description":"Go to reset state instead of failed state. This is against the ISO15118-3. But some cars directly send a CM_SLAC_PARAM.req message when the SLAC process aborts. To react to this message and restart the SLAC process, the EVSE go to the reset state here.","mutability":"ReadOnly","type":"boolean"},"set_key_timeout_ms":{"default":1000,"description":"Timeout for CM_SET_KEY.REQ. Default works for QCA7000/QCA7005/CG5317.","mutability":"ReadOnly","type":"integer"},"sounding_attenuation_adjustment":{"default":0,"description":"Offset in dB that should be added to the calculated sounding attenuation","mutability":"ReadOnly","type":"integer"}},"description":"SLAC interface implementation.","interface":"slac"}},"requires":{}}
everest/manifests/EvseV2G {"description":"This module includes a DIN70121 and ISO15118-2 implementation provided by chargebyte GmbH","enable_external_mqtt":false,"enable_global_errors":false,"enable_telemetry":false,"metadata":{"authors":["Fabian Hartung","Mohannad Oraby","Sebastian Lukas"],"license":"https://opensource.org/licenses/Apache-2.0"},"provides":{"charger":{"config":{},"description":"This module implements the ISO15118-2 implementation of an AC or DC charger","interface":"ISO15118_charger"},"extensions":{"config":{},"description":"This interface is used to share data between ISO15118 and OCPP modules to support the requirements of the OCPP protocol","interface":"iso15118_extensions"}},"requires":{"security":{"interface":"evse_security","max_connections":1,"min_connections":1}}}
everest/manifests/InfyPower {"description":"Driver for InfyPower ACDC power supply. Supports multiple InfyPower modules using V1.13 CAN protocol either in fixed address mode or group discovery mode.","enable_external_mqtt":false,"enable_global_errors":false,"enable_telemetry":false,"metadata":{"authors":["Florin Mihut"],"license":"https://opensource.org/licenses/Apache-2.0"},"provides":{"main":{"config":{},"description":"Main interface","interface":"power_supply_DC"}},"requires":{}}
everest/manifests/SerialCommHub {"description":"Hub to communicate with attached serial devices","enable_external_mqtt":false,"enable_global_errors":false,"enable_telemetry":false,"metadata":{"authors":["Lars Dieckmann","Cornelius Claussen"],"license":"https://opensource.org/licenses/Apache-2.0"},"provides":{"main":{"config":{"baudrate":{"default":9600,"description":"Baudrate","maximum":230400,"minimum":0,"mutability":"ReadOnly","type":"integer"},"ignore_echo":{"default":false,"description":"On some hardware every message that is sent is read back, this setting filters the sent message in the reply.","mutability":"ReadOnly","type":"boolean"},"initial_timeout_ms":{"default":500,"description":"Timeout in ms for the first packet.","mutability":"ReadOnly","type":"integer"},"max_packet_size":{"default":256,"description":"Maximum size of a packet to read/write in bytes. Payload exceeding the size will be chunked. The APU size according to [wikipedia](https://en.wikipedia.org/wiki/Modbus) is 256 bytes, which is used as default here.","maximum":65536,"minimum":7,"mutability":"ReadOnly","type":"integer"},"parity":{"default":0,"description":"Parity bit: 0: None, 1: Odd, 2: Even","maximum":2,"minimum":0,"mutability":"ReadOnly","type":"integer"},"retries":{"default":2,"description":"Count of retries in case of error in Modbus query.","maximum":10,"minimum":0,"mutability":"ReadOnly","type":"integer"},"rtscts":{"default":false,"description":"Use RTS/CTS hardware flow control","mutability":"ReadOnly","type":"boolean"},"rxtx_gpio_chip":{"default":"","description":"GPIO chip to use to switch between RX/TX. An empty string disables GPIO usage.","mutability":"ReadOnly","type":"string"},"rxtx_gpio_line":{"default":0,"description":"GPIO line to use to switch between RX/TX","mutability":"ReadOnly","type":"integer"},"rxtx_gpio_tx_high":{"default":false,"description":"GPIO direction, false means low for TX, true means high for TX","mutability":"ReadOnly","type":"boolean"},"serial_port":{"default":"/dev/ttyUSB0","description":"Serial port the hardware is connected to","mutability":"ReadOnly","type":"string"},"within_message_timeout_ms":{"default":100,"description":"Timeout in ms for subsequent packets.","mutability":"ReadOnly","type":"integer"}},"description":"Implementation of serial communication hub","interface":"serial_communication_hub"}},"requires":{}}
