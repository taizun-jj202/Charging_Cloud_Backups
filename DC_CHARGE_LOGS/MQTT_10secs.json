everest/manifests/Auth {"description":"This module implements the authentication handling for the EVerest. It is responsible for providing authorization to the connected evse managers. In addition to that, it handles the reservation management.","enable_external_mqtt":false,"enable_global_errors":false,"enable_telemetry":false,"metadata":{"authors":["Piet Gömpel"],"license":"https://opensource.org/licenses/Apache-2.0"},"provides":{"main":{"config":{},"description":"This implements the auth interface for EVerest","interface":"auth"},"reservation":{"config":{},"description":"This implements the reservation interface for EVerest.","interface":"reservation"}},"requires":{"evse_manager":{"interface":"evse_manager","max_connections":128,"min_connections":1},"kvs":{"interface":"kvs","max_connections":1,"min_connections":0},"token_provider":{"interface":"auth_token_provider","max_connections":128,"min_connections":1},"token_validator":{"interface":"auth_token_validator","max_connections":128,"min_connections":1}}}
everest/manifests/Bender_isoCHA425HV {"description":"IMD driver for Bender isoCHA425HV IMD devices.","enable_external_mqtt":false,"enable_global_errors":false,"enable_telemetry":false,"metadata":{"authors":["Cornelius Claussen","Florin Mihut","Jan Christoph Habig","Lars Dieckmann"],"license":"https://opensource.org/licenses/Apache-2.0"},"provides":{"main":{"config":{"alarm_memory_enable":{"default":false,"description":"3012 Enable memory for alarm events","mutability":"ReadOnly","type":"boolean"},"always_publish_measurements":{"default":false,"description":"Always publish measurement even if stopped by EVerest","mutability":"ReadOnly","type":"boolean"},"chademo_mode":{"default":false,"description":"3023: false: CCS, true: ChaDeMo","mutability":"ReadOnly","type":"boolean"},"delay_startup_device":{"default":5,"description":"3018 Delay when device is starting up","maximum":10,"minimum":0,"mutability":"ReadOnly","type":"integer"},"delay_t_off_k1_k2":{"default":5,"description":"3020 delay for switching relais off","maximum":99,"minimum":0,"mutability":"ReadOnly","type":"integer"},"delay_t_on_k1_k2":{"default":5,"description":"3019 delay for switching relais on","maximum":99,"minimum":0,"mutability":"ReadOnly","type":"integer"},"imd_device_id":{"default":3,"description":"The IMD's address on the ModBus","maximum":255,"minimum":0,"mutability":"ReadOnly","type":"integer"},"overvoltage_alarm_enable":{"default":false,"description":"3010 Enable over voltage alarm","mutability":"ReadOnly","type":"boolean"},"overvoltage_alarm_threshold_V":{"default":1050,"description":"3011 Threshold in volt for the over voltage alarm","mutability":"ReadOnly","type":"integer"},"r1_prealarm_kohm":{"default":250,"description":"3005 The IMD's internal measurement resistance for signaling an alarm in kiloohms (the internal resistance is only used for switching the IMDs relays, EVerest handles any isolation issue internaly inside the EVSE manager) Note the maximum value is 600k on isoCHA and 500k on isoEV units.","maximum":600,"minimum":15,"mutability":"ReadOnly","type":"integer"},"r2_alarm_kohm":{"default":100,"description":"3007 This value must be smaller than r1_prealarm_kohm","maximum":600,"minimum":15,"mutability":"ReadOnly","type":"integer"},"relais_r1_mode":{"default":false,"description":"3013 false: normally open, true: normally closed","mutability":"ReadOnly","type":"boolean"},"relais_r2_mode":{"default":false,"description":"3014 false: normally open, true: normally closed","mutability":"ReadOnly","type":"boolean"},"selftest_enable_at_start":{"default":true,"description":"3025 Perform self test at start up of device","mutability":"ReadOnly","type":"boolean"},"selftest_enable_gridconnection":{"default":false,"description":"3024: Test grid connection while testing device nEt","mutability":"ReadOnly","type":"boolean"},"undervoltage_alarm_enable":{"default":false,"description":"3008 Enable under voltage alarm","mutability":"ReadOnly","type":"boolean"},"undervoltage_alarm_threshold_V":{"default":30,"description":"3009 Threshold in volt for the under voltage alarm","mutability":"ReadOnly","type":"integer"}},"description":"Implementation of the driver functionality","interface":"isolation_monitor"}},"requires":{"serial_comm_hub":{"interface":"serial_communication_hub","max_connections":1,"min_connections":1}}}
